# ── selfcheck configuration ────────────────────────────────────────────────
# Copy to .env and fill in. selfcheck only ever READS from these hosts.

# Bind address. Keep on loopback unless you know what you're doing.
SELFCHECK_HOST=127.0.0.1
SELFCHECK_PORT=7777

# Where the SQLite db and the read-only repo cache live.
SELFCHECK_DATA_DIR=./data

# ── Provider tokens (read scopes only are needed) ──────────────────────────
# GitHub: a classic PAT with `repo` (read) or a fine-grained token with
# "Pull requests: Read-only" + "Contents: Read-only".
GITHUB_TOKEN=

# GitLab: a PAT with `read_api` + `read_repository`.
GITLAB_TOKEN=

# Extra hosts: JSON map of host -> token, for self-hosted GitHub Enterprise
# or GitLab instances. Example:
# SELFCHECK_HOST_TOKENS={"gitlab.mycorp.com":"glpat-xxx","ghe.mycorp.com":"ghp_xxx"}
SELFCHECK_HOST_TOKENS=

# ── Review engines ─────────────────────────────────────────────────────────
# Which engine reviews when you do not pick one: claude | codex | cursor |
# anthropic | openai. Any engine can still be chosen per run, per PR or per
# wakeup from the UI.
SELFCHECK_ENGINE=claude
# Default depth: light | normal | thorough.
SELFCHECK_DEFAULT_MODE=normal
# Reviews running at once; the rest queue. Keeps a wakeup that finds ten new
# PRs from spending on all ten simultaneously.
SELFCHECK_MAX_CONCURRENT_RUNS=2
# Hard ceiling on a normal run. Light runs get half, thorough runs double.
SELFCHECK_RUN_TIMEOUT_SECONDS=900
# Feed findings you dismissed in a repository back into its next reviews.
SELFCHECK_LEARN_FROM_DISMISSALS=1
# Spend caps in USD for automatic reviews (wakeups, watches); 0 = no cap.
SELFCHECK_DAILY_BUDGET_USD=0
SELFCHECK_MONTHLY_BUDGET_USD=0

# Claude Code CLI. Model: alias or full id; empty = the CLI's default.
SELFCHECK_CLAUDE_BIN=claude
SELFCHECK_CLAUDE_MODEL=

# OpenAI Codex CLI (`codex exec`, read-only sandbox).
SELFCHECK_CODEX_BIN=codex
SELFCHECK_CODEX_MODEL=

# Cursor Agent CLI (`cursor-agent`, ask mode).
SELFCHECK_CURSOR_BIN=cursor-agent
SELFCHECK_CURSOR_MODEL=

# Anthropic API. selfcheck runs the tool loop itself, with read-only tools.
# Empty key = whatever `ant auth login` or the environment provides.
ANTHROPIC_API_KEY=
SELFCHECK_ANTHROPIC_MODEL=claude-opus-5-5

# Any OpenAI-compatible endpoint. For a review that never leaves the machine:
#   Ollama     http://localhost:11434/v1   (no key)
#   LM Studio  http://localhost:1234/v1    (no key)
SELFCHECK_OPENAI_BASE_URL=https://api.openai.com/v1
SELFCHECK_OPENAI_API_KEY=
SELFCHECK_OPENAI_MODEL=

# ── Repo cache ─────────────────────────────────────────────────────────────
# Set to 0 to disable cloning entirely (the engine then only sees the diff).
SELFCHECK_CLONE_ENABLED=1
# Cap on cache size before least-recently-used mirrors are pruned.
SELFCHECK_CACHE_MAX_GB=10

# ── Auto-refresh ───────────────────────────────────────────────────────────
# Background poll interval (seconds) for reviews with watch enabled.
SELFCHECK_WATCH_INTERVAL_SECONDS=300
