# ── selfcheck configuration ────────────────────────────────────────────────
# Copy to .env and fill in. selfcheck only ever READS from these hosts.

# Bind address. Keep on loopback unless you know what you're doing.
SELFCHECK_HOST=127.0.0.1
SELFCHECK_PORT=7777

# Where the SQLite db and the read-only repo cache live.
SELFCHECK_DATA_DIR=./data

# ── Provider tokens (read scopes only are needed) ──────────────────────────
# GitHub: a classic PAT with `repo` (read) or a fine-grained token with
# "Pull requests: Read-only" + "Contents: Read-only".
GITHUB_TOKEN=

# GitLab: a PAT with `read_api` + `read_repository`.
GITLAB_TOKEN=

# Extra hosts: JSON map of host -> token, for self-hosted GitHub Enterprise
# or GitLab instances. Example:
# SELFCHECK_HOST_TOKENS={"gitlab.mycorp.com":"glpat-xxx","ghe.mycorp.com":"ghp_xxx"}
SELFCHECK_HOST_TOKENS=

# ── Claude ─────────────────────────────────────────────────────────────────
# Path to the locally installed Claude Code CLI.
SELFCHECK_CLAUDE_BIN=claude
# Model alias or full id. Empty = whatever your CLI defaults to.
SELFCHECK_CLAUDE_MODEL=
# Hard ceiling on a single review run.
SELFCHECK_RUN_TIMEOUT_SECONDS=900

# ── Repo cache ─────────────────────────────────────────────────────────────
# Set to 0 to disable cloning entirely (Claude then only sees the diff).
SELFCHECK_CLONE_ENABLED=1
# Cap on cache size before least-recently-used mirrors are pruned.
SELFCHECK_CACHE_MAX_GB=10

# ── Auto-refresh ───────────────────────────────────────────────────────────
# Background poll interval (seconds) for reviews with watch enabled.
SELFCHECK_WATCH_INTERVAL_SECONDS=300
